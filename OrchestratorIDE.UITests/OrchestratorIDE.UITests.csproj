<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTestProject>true</IsTestProject>
    <!-- FlaUI launches the WPF exe — must run on Windows -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- GDI+ types (Bitmap, Graphics, etc.) come from System.Drawing.Common package below -->
  </PropertyGroup>

  <!--
    FlaUI tests only RUN on Windows, but the project sits in OrchestratorIDE.slnx, so on a
    macOS/Linux host `dotnet build OrchestratorIDE.slnx` failed with NETSDK1073 (WindowsDesktop
    framework refs unknown). EnableWindowsTargeting lets the non-Windows SDK resolve the Windows
    targeting packs so the project compiles; THEORC_NO_DPAPI mirrors UnitTests.csproj because the
    referenced Avalonia build has no DpapiSecretProtector off Windows. No effect on Windows hosts.
  -->
  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DefineConstants>$(DefineConstants);THEORC_NO_DPAPI</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- UI Automation -->
    <PackageReference Include="FlaUI.Core"  Version="4.0.0" />
    <PackageReference Include="FlaUI.UIA3"  Version="4.0.0" />

    <!-- Screen recording during tests (same library as main app F12 recorder) -->
    <PackageReference Include="SharpAvi" Version="3.0.1" />

    <!-- Override System.Drawing.Common to a version without the critical CVE
         (NU1904 — GHSA-rxg9-xrhp-64gj) pulled in transitively by FlaUI -->
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />

    <!-- Test framework -->
    <PackageReference Include="NUnit"                   Version="4.2.0"  />
    <PackageReference Include="NUnit3TestAdapter"        Version="4.6.0"  />
    <PackageReference Include="Microsoft.NET.Test.Sdk"  Version="18.11.0"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Direct reference for white-box unit tests (language detection etc.);
         FlaUI black-box tests still launch the built exe separately.
         Avalonia, not WPF, since WPF retirement Phase 5 deleted OrchestratorIDE.csproj. -->
    <ProjectReference Include="..\OrchestratorIDE.Avalonia\OrchestratorIDE.Avalonia.csproj" />
  </ItemGroup>

</Project>
