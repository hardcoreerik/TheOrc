<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!--
      On macOS/Linux hosts a net10.0-windows test assembly builds but `dotnet test` discovers
      zero tests. The Windows TFM was only needed for the deleted WPF project; everything this
      references (Avalonia, NativeRuntime) is plain net10.0, so use that off Windows.
    -->
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTestProject>true</IsTestProject>
    <!--
      net10.0-windows is required to reference the WPF main project.
      UseWPF is NOT set here, so no display or desktop session is needed —
      these tests run headlessly via SSH or CI with plain "dotnet test".
    -->
  </PropertyGroup>

  <!--
    Pure unit tests (T10-T17) are physically in OrchestratorIDE.UITests\Tests\
    and shared here via Compile Include so there is a single source of truth.
    UITests compiles them inside an assembly that has AppFixture, causing every
    test to fail on headless machines. This project compiles the same files
    without AppFixture, making them safe for headless / SSH execution.
  -->
  <ItemGroup>
    <Compile Include="..\OrchestratorIDE.UITests\Tests\T10_LanguageDetectionTests.cs" />
    <Compile Include="..\OrchestratorIDE.UITests\Tests\T11_SteeringTests.cs" />
    <Compile Include="..\OrchestratorIDE.UITests\Tests\T12_ModelWikiExportTests.cs" />
    <Compile Include="..\OrchestratorIDE.UITests\Tests\T13_TokenCostEstimatorTests.cs" />
    <Compile Include="..\OrchestratorIDE.UITests\Tests\T14_HiveHostsTests.cs" />
    <Compile Include="..\OrchestratorIDE.UITests\Tests\T15_HiveMindPhase3Tests.cs" />
    <Compile Include="..\OrchestratorIDE.UITests\Tests\T16_WorktreeIsolationTests.cs" />
    <Compile Include="..\OrchestratorIDE.UITests\Tests\T17_HiveSecurityTests.cs" />
    <Compile Include="..\OrchestratorIDE.UITests\Tests\T18_HivePersistenceTests.cs" />
    <Compile Include="..\OrchestratorIDE.UITests\Tests\T19_GraphRepositoryTests.cs" />
    <!--
      DaemonConfig.cs is a dependency-free POCO (System.* only) physically owned by
      OrchestratorIDE.Daemon. A ProjectReference there is NOT viable: OrchestratorIDE.Daemon
      and OrchestratorIDE.Avalonia (already referenced above) both compile the shared Hive/*
      sources under the same "OrchestratorIDE" root namespace, so referencing both assemblies
      at once collides on ~20 duplicate types (HiveIdentity, SqliteStore, HiveTaskQueue, etc.,
      CS0433). Compiling just this one self-contained file in avoids that entirely.
    -->
    <Compile Include="..\OrchestratorIDE.Daemon\DaemonConfig.cs" Link="Daemon\DaemonConfig.cs" />
  </ItemGroup>

  <!--
    DpapiSecretProtector is compiled into OrchestratorIDE.Avalonia only when it targets Windows
    (see that csproj's _TargetsWindows). On a macOS/Linux build host it does not exist, so the
    HIVE fixtures that initialize SecretProtection switch to an in-memory AES-GCM key there.
    Same target-OS rule as the Avalonia project; Windows builds are unaffected.
  -->
  <PropertyGroup>
    <_TheOrcTestTargetsWindows Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier.StartsWith('win'))</_TheOrcTestTargetsWindows>
    <_TheOrcTestTargetsWindows Condition="'$(RuntimeIdentifier)' == ''">$([MSBuild]::IsOSPlatform('Windows'))</_TheOrcTestTargetsWindows>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_TheOrcTestTargetsWindows)' != 'true'">
    <DefineConstants>$(DefineConstants);THEORC_NO_DPAPI</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="NUnit"                  Version="4.6.1"  />
    <PackageReference Include="NUnit3TestAdapter"       Version="4.6.0"  />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OrchestratorIDE.Avalonia\OrchestratorIDE.Avalonia.csproj" />
    <ProjectReference Include="..\OrchestratorIDE.NativeRuntime\OrchestratorIDE.NativeRuntime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="TestData\ContextFabric\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
