<Window x:Class="OrchestratorIDE.UI.Windows.ModelDepotWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1280"
        Height="840"
        MinWidth="1000"
        MinHeight="640"
        Background="#101310"
        Title="Model Depot"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="ModelDepotWindow.Root">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
        <!-- Header -->
        <Border Grid.Row="0"
                Background="#141814"
                BorderBrush="#2E3A2E"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid ColumnDefinitions="*,420">
                <StackPanel>
                    <TextBlock Text="Model Depot"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#76B900"/>
                    <TextBlock Margin="0,6,0,0"
                               FontSize="12"
                               Foreground="#D4D4D4"
                               Text="Browse TheOrc's curated model library — specs, benchmarks, install state, and downloads in one place."/>
                </StackPanel>

                <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                    <TextBox x:Name="TxtSearch"
                             Grid.Column="0"
                             Height="34"
                             PlaceholderText="Search name, publisher, or tag..."
                             Background="#0E120E"
                             Foreground="#F3F3F3"
                             BorderBrush="#2E3A2E"
                             Padding="10,6"
                             FontSize="13"
                             TextChanged="TxtSearch_TextChanged"
                             AutomationProperties.AutomationId="ModelDepotWindow.SearchBox"/>
                    <Button x:Name="BtnLiveSearch"
                            Grid.Column="1"
                            Height="34"
                            MinWidth="120"
                            Content="Search HF live"
                            Click="BtnLiveSearch_Click"
                            Background="#142033"
                            Foreground="#72B7FF"
                            BorderBrush="#314C71"
                            ToolTip.Tip="Widen results with a live Hugging Face search beyond the curated catalog"
                            AutomationProperties.AutomationId="ModelDepotWindow.LiveSearchButton"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Filter chip row -->
        <Border Grid.Row="1"
                Background="#111511"
                BorderBrush="#1F281F"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <StackPanel Spacing="8">
                <WrapPanel x:Name="WpRoleFilters" VerticalAlignment="Center">
                    <TextBlock Text="Role:" Foreground="#A6B0A6" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                </WrapPanel>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="VRAM:" Foreground="#A6B0A6" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ToggleButton x:Name="TbVram4"  Content="≤4 GB"  Click="VramFilter_Click" Tag="4"  Margin="0,0,6,0" Padding="8,3" FontSize="11"/>
                    <ToggleButton x:Name="TbVram8"  Content="≤8 GB"  Click="VramFilter_Click" Tag="8"  Margin="0,0,6,0" Padding="8,3" FontSize="11"/>
                    <ToggleButton x:Name="TbVram12" Content="≤12 GB" Click="VramFilter_Click" Tag="12" Margin="0,0,6,0" Padding="8,3" FontSize="11"/>
                    <ToggleButton x:Name="TbVram24" Content="≤24 GB" Click="VramFilter_Click" Tag="24" Margin="0,0,16,0" Padding="8,3" FontSize="11"/>

                    <TextBlock Text="Quality:" Foreground="#A6B0A6" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ToggleButton x:Name="TbQuality4" Content="★★★★+" Click="QualityFilter_Click" Tag="4" Margin="0,0,16,0" Padding="8,3" FontSize="11"/>

                    <ToggleButton x:Name="TbInstalledOnly" Content="✅ Installed only" Click="InstalledFilter_Click" Padding="8,3" FontSize="11" Margin="0,0,16,0"/>
                    <ToggleButton x:Name="TbHiveOnly" Content="🐝 On HIVE only" Click="HiveFilter_Click" Padding="8,3" FontSize="11" Margin="0,0,16,0"/>

                    <Button Content="Clear filters" Click="BtnClearFilters_Click" Padding="8,3" FontSize="11"
                            Background="#1B211B" Foreground="#DADADA" BorderBrush="#2E3A2E"/>
                </WrapPanel>
                <WrapPanel x:Name="WpTagFilters" VerticalAlignment="Center">
                    <TextBlock Text="Tags:" Foreground="#A6B0A6" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                </WrapPanel>
                <WrapPanel VerticalAlignment="Center">
                    <Button x:Name="BtnScanHive"
                            Content="🐝 Search PC/Network"
                            Click="BtnScanHive_Click"
                            Padding="8,4"
                            FontSize="11"
                            Margin="0,0,10,0"
                            Background="#221A08"
                            Foreground="#FFCA57"
                            BorderBrush="#4A3410"
                            ToolTip.Tip="Scan the LAN for other TheOrc/HIVE nodes and show which peers already have each model"
                            AutomationProperties.AutomationId="ModelDepotWindow.ScanHiveButton"/>
                    <TextBlock x:Name="TxtHiveScanStatus" FontSize="11" Foreground="#A6B0A6" VerticalAlignment="Center"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Card grid + detail pane -->
        <Grid Grid.Row="2" ColumnDefinitions="*,6,460">
            <Grid Grid.Column="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="14,12">
                        <TextBlock x:Name="TxtResultCount"
                                   FontSize="12"
                                   Foreground="#A6B0A6"
                                   Margin="0,0,0,10"/>
                        <ItemsControl x:Name="CardGrid">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="#1C231C"/>

            <Grid Grid.Column="2">
                <Border x:Name="PanelNoSelection" Background="#0A0D0A" IsVisible="True">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                        <TextBlock Text="Select a model to see full details"
                                   FontSize="16" FontWeight="SemiBold" Foreground="#EAEAEA" HorizontalAlignment="Center"/>
                        <TextBlock Text="Curated cards show specs, benchmarks, and quant variants; community hits degrade gracefully to catalog metadata."
                                   FontSize="12" Foreground="#98A198" TextWrapping="Wrap" MaxWidth="380"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="PanelDetail" IsVisible="False" Background="#0A0D0A" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,16" Spacing="12">
                        <WrapPanel x:Name="WpDetailBadges"/>

                        <TextBlock x:Name="TxtDetailName" FontSize="22" FontWeight="Bold" Foreground="#F6F6F6" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtDetailPublisher" FontSize="12" Foreground="#A6B0A6" TextWrapping="Wrap"/>

                        <WrapPanel x:Name="WpDetailStats"/>

                        <TextBlock x:Name="TxtDetailDesc" FontSize="13" Foreground="#DFDFDF" TextWrapping="Wrap" LineHeight="20"/>

                        <Border x:Name="BdrQuants" IsVisible="False" Background="#0F130F" BorderBrush="#243024" BorderThickness="1" CornerRadius="4" Padding="12,10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="AVAILABLE QUANTIZATIONS" FontSize="10" FontWeight="Bold" Foreground="#7CE67C"/>
                                <TextBlock x:Name="TxtQuants" FontSize="12" Foreground="#E6E6E6" TextWrapping="Wrap" LineHeight="18"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="BdrEvidence" IsVisible="False" Background="#0F1116" BorderBrush="#283044" BorderThickness="1" CornerRadius="4" Padding="12,10">
                            <StackPanel Spacing="6">
                                <TextBlock Text="LOCAL EVIDENCE" FontSize="10" FontWeight="Bold" Foreground="#72B7FF"/>
                                <TextBlock x:Name="TxtEvidenceRole" FontSize="12" Foreground="#E6E6E6" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtEvidenceLongWrite" FontSize="12" Foreground="#FF8A8A" TextWrapping="Wrap" IsVisible="False"/>
                                <TextBlock x:Name="TxtEvidenceSwarm" FontSize="11" Foreground="#A6B0A6" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="BdrInstalled" IsVisible="False" Background="#122012" BorderBrush="#214421" BorderThickness="1" CornerRadius="4" Padding="12,10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="INSTALLED LOCALLY" FontSize="10" FontWeight="Bold" Foreground="#7CE67C"/>
                                <TextBlock x:Name="TxtInstalledInfo" FontSize="12" Foreground="#E6E6E6" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="BdrHiveAvailability" IsVisible="False" Background="#221A08" BorderBrush="#4A3410" BorderThickness="1" CornerRadius="4" Padding="12,10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="AVAILABLE ON HIVE" FontSize="10" FontWeight="Bold" Foreground="#FFCA57"/>
                                <TextBlock x:Name="TxtHiveAvailability" FontSize="12" Foreground="#E6E6E6" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0F1116" BorderBrush="#283044" BorderThickness="1" CornerRadius="4" Padding="12,10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="ASSIGN ROLE AFTER DOWNLOAD" FontSize="10" FontWeight="Bold" Foreground="#A6B0A6"/>
                                <WrapPanel>
                                    <RadioButton x:Name="RbRoleWorker" GroupName="DepotRole" Content="Worker · Coder" IsChecked="True" Foreground="#7CE67C" Margin="0,0,14,0"/>
                                    <RadioButton x:Name="RbRoleBoss" GroupName="DepotRole" Content="Boss · Orchestrator" Foreground="#FFCA57" Margin="0,0,14,0"/>
                                    <RadioButton x:Name="RbRoleResearcher" GroupName="DepotRole" Content="Researcher" Foreground="#72B7FF" Margin="0,0,14,0"/>
                                    <RadioButton x:Name="RbRoleLibrary" GroupName="DepotRole" Content="Library only" Foreground="#A6B0A6"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <WrapPanel>
                            <Button x:Name="BtnDownload"
                                    Content="Download"
                                    Click="BtnDownload_Click"
                                    IsEnabled="False"
                                    MinWidth="150"
                                    Padding="14,8"
                                    Margin="0,0,10,0"
                                    Background="#76B900"
                                    Foreground="#0F120F"
                                    BorderBrush="#76B900"
                                    FontWeight="SemiBold"
                                    AutomationProperties.AutomationId="ModelDepotWindow.DownloadButton"/>
                            <Button Content="Close"
                                    Click="BtnClose_Click"
                                    MinWidth="90"
                                    Padding="14,8"
                                    Background="#1B211B"
                                    Foreground="#DADADA"
                                    BorderBrush="#2E3A2E"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Download progress -->
        <Border x:Name="PanelDownloadProgress"
                Grid.Row="3"
                IsVisible="False"
                Background="#121812"
                BorderBrush="#2E3A2E"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid RowDefinitions="Auto,Auto,Auto">
                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock x:Name="TxtDlFileName" DockPanel.Dock="Left" FontSize="12" FontWeight="SemiBold" Foreground="#F2F2F2"/>
                    <TextBlock x:Name="TxtDlStats" DockPanel.Dock="Right" HorizontalAlignment="Right" FontSize="11" Foreground="#76B900" FontFamily="Consolas"/>
                </DockPanel>
                <ProgressBar Grid.Row="1" x:Name="PbDownload" Minimum="0" Maximum="100" Height="8" Margin="0,0,0,6"/>
                <DockPanel Grid.Row="2">
                    <TextBlock x:Name="TxtDlStatus" DockPanel.Dock="Left" FontSize="11" Foreground="#A6B0A6" TextWrapping="Wrap"/>
                    <Button x:Name="BtnCancelDownload" DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Cancel"
                            Click="BtnCancelDownload_Click" Padding="10,4" Background="#311616" Foreground="#FF8A8A" BorderBrush="#5A2A2A"/>
                </DockPanel>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="4"
                Background="#111411"
                BorderBrush="#2E3A2E"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <DockPanel>
                <TextBlock x:Name="TxtWindowStatus"
                           DockPanel.Dock="Left"
                           FontSize="11"
                           Foreground="#A6B0A6"
                           Text="Loading catalog..."/>
                <TextBlock x:Name="TxtHardwareSummary"
                           DockPanel.Dock="Right"
                           HorizontalAlignment="Right"
                           FontSize="11"
                           Foreground="#76B900"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
